<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Room <%= roomCode %></title>
    <script src="/socket.io/socket.io.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/color-thief/2.3.0/color-thief.umd.js"></script>
    <link rel="stylesheet" href="/main.css" />
</head>
<body class="m3-container">
    <div class="player-layout">
        <div class="artwork-card">
            <img src="" alt="Album Art" id="songImg" crossorigin="anonymous" />
        </div>

        <div class="player-controls">
            <header class="player-header">
                <div class="status-badge" id="info">Connecting...</div>
                <h1 class="room-title">Room <%= roomCode %></h1>
            </header>

            <div class="song-meta">
                <h2 id="song">No song playing</h2>
                <p id="artist">Unknown Artist</p>
            </div>

            <div class="seekbar-container">
                <canvas id="waveCanvas"></canvas>
                <input type="range" id="slideBar" min="0" max="1" step="0.001" value="0" />
                <div class="time-info">
                    <span id="currentTime">0:00</span>
                    <span id="totalTime">0:00</span>
                </div>
            </div>

            <div class="controller">
                <button class="m3-icon-btn" id="prevSong">
                    <span class="material-symbols-rounded">skip_previous</span>
                </button>
                <button class="m3-fab" id="play_pause">
                    <span class="material-symbols-rounded" id="playIcon">play_arrow</span>
                </button>
                <button class="m3-icon-btn" id="nextSong">
                    <span class="material-symbols-rounded">skip_next</span>
                </button>
            </div>

            <div class="actions-row">
                <button class="m3-text-btn" id="updateQueue">
                    <span class="material-symbols-rounded">queue_music</span> Queue
                </button>
                <div class="chat-toggle">
                    <input id="msgInput" placeholder="Message..." />
                    <button id="sendBtn" class="m3-icon-btn small">
                        <span class="material-symbols-rounded">send</span>
                    </button>
                </div>
            </div>
        </div>

        <aside class="side-panel">
            <div class="panel-section">
                <h3>Queue</h3>
                <div id="queueContainer" class="m3-list"></div>
            </div>
            <div class="panel-section">
                <h3>Messages</h3>
                <ul id="messages" class="m3-chat-list"></ul>
            </div>
        </aside>
    </div>

    <script src="/logic.js"></script>
</body>
</html>